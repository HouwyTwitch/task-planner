<Window x:Class="Planner.App.MainWindow"
        Language="ru-RU"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Planner.App.ViewModels"
        xmlns:views="clr-namespace:Planner.App.Views"
        Title="Сетевой планировщик" Icon="Assets/NetworkPlanner.ico" Height="850" Width="1450" MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#DADCE0" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Сегодня" Command="{Binding TodayCommand}"/>
                    <Button Content="◀" ToolTip="Назад" Command="{Binding PreviousCommand}"/>
                    <Button Content="▶" ToolTip="Вперёд" Command="{Binding NextCommand}"/>
                    <TextBlock Text="{Binding SelectedUserCaption}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="15,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="День" Command="{Binding SetViewCommand}" CommandParameter="Day"/>
                    <Button Content="Рабочая неделя" Command="{Binding SetViewCommand}" CommandParameter="WorkWeek"/>
                    <Button Content="Месяц" Command="{Binding SetViewCommand}" CommandParameter="Month"/>
                    <Button Content="⟳" ToolTip="Обновить" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="Новая задача:" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#5F6368"/>
                    <ComboBox ItemsSource="{Binding NewTaskDurationOptions}" SelectedItem="{Binding SelectedNewTaskDurationMinutes}" Width="66" VerticalAlignment="Center" ToolTip="Длительность задачи при двойном клике по сетке"/>
                    <TextBlock Text="мин" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="#5F6368"/>
                    <Button Content="＋ Новая задача" Command="{Binding NewTaskCommand}" Background="{StaticResource AccentBrush}" Foreground="White"/>
                    <Button Content="Открыть задачу" Command="{Binding EditTaskCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#DADCE0" BorderThickness="0,0,1,0" Padding="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="220"/></Grid.RowDefinitions>
                    <GroupBox Header="Сотрудники">
                        <TreeView ItemsSource="{Binding UserRoots}" SelectedItemChanged="UsersTree_SelectedItemChanged">
                            <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type vm:UserTreeNodeViewModel}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayName}" Padding="2"/></HierarchicalDataTemplate></TreeView.Resources>
                        </TreeView>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="Шаблоны повторяющихся задач">
                        <ListBox ItemsSource="{Binding RecurringTemplates}" SelectedItem="{Binding SelectedTask}" MouseDoubleClick="TaskList_MouseDoubleClick" ContextMenuOpening="RecurringList_ContextMenuOpening">
                            <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                            <ListBox.ItemTemplate><DataTemplate><Border Padding="6" Margin="2" Background="White" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StartDate, StringFormat=С: {0:dd.MM.yyyy}}" FontSize="10" Foreground="#777"/><TextBlock Text="{Binding CronSchedule, StringFormat='Расписание: {0}'}" FontSize="10" Foreground="#777" TextWrapping="Wrap"/><TextBlock Text="{Binding AssignedToDisplayName, StringFormat=Исполнитель: {0}}" FontSize="10" Foreground="#666" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusDisplay, StringFormat=Статус: {0}}" FontSize="10" Foreground="#666"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <views:CalendarSurface Visibility="{Binding IsTimeView,Converter={StaticResource BoolToVisibility}}"/>
                <views:MonthView Visibility="{Binding IsMonthView,Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
            <Border Grid.Column="2" BorderBrush="#DADCE0" BorderThickness="1,0,0,0" Padding="8" Visibility="{Binding IsAdmin,Converter={StaticResource BoolToVisibility}}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Администрирование" FontSize="16" FontWeight="SemiBold" Margin="3,3,3,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding SelectedAdminUser}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns><DataGridTextColumn Header="ФИО" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Учётная запись Windows" Binding="{Binding Username}" Width="145"/><DataGridTextColumn Header="Роль" Binding="{Binding RoleDisplay}" Width="90"/></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Добавить" Command="{Binding NewUserCommand}"/><Button Content="Редактировать" Command="{Binding EditUserCommand}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DADCE0" BorderThickness="0,1,0,0">
            <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="{Binding LoggedUser.DisplayName, StringFormat=Пользователь: {0}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
