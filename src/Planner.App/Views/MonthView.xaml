<UserControl x:Class="Planner.App.Views.MonthView" Language="ru-RU"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="MonthTaskButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#1A73E8"/>
   <Setter Property="BorderBrush" Value="#1558B0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5,3"/>
   <Setter Property="Margin" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding VisualState}" Value="InProgress">
     <Setter Property="Background" Value="#188038"/>
     <Setter Property="BorderBrush" Value="#0D652D"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding VisualState}" Value="Overdue">
     <Setter Property="Background" Value="#D93025"/>
     <Setter Property="BorderBrush" Value="#A50E0E"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding VisualState}" Value="Completed">
     <Setter Property="Background" Value="#80868B"/>
     <Setter Property="BorderBrush" Value="#5F6368"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="MonthDayCellStyle" TargetType="Border">
   <Setter Property="BorderBrush" Value="#E0E0E0"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="4"/>
   <Setter Property="Background" Value="White"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
     <Setter Property="Background" Value="#F4F5F7"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding IsToday}" Value="True">
     <Setter Property="Background" Value="#E8F0FE"/>
     <Setter Property="BorderBrush" Value="#1A73E8"/>
     <Setter Property="BorderThickness" Value="1"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="MonthDayNumberStyle" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#202124"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
     <Setter Property="Foreground" Value="#9AA0A6"/>
     <Setter Property="FontWeight" Value="Normal"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding IsToday}" Value="True">
     <Setter Property="Foreground" Value="#1A73E8"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
   <TextBlock Text="{Binding MonthCaption}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
  </Border>
  <UniformGrid Grid.Row="1" Columns="7"><TextBlock Text="Пн" HorizontalAlignment="Center"/><TextBlock Text="Вт" HorizontalAlignment="Center"/><TextBlock Text="Ср" HorizontalAlignment="Center"/><TextBlock Text="Чт" HorizontalAlignment="Center"/><TextBlock Text="Пт" HorizontalAlignment="Center"/><TextBlock Text="Сб" HorizontalAlignment="Center"/><TextBlock Text="Вс" HorizontalAlignment="Center"/></UniformGrid>
  <ItemsControl Grid.Row="2" ItemsSource="{Binding MonthDays}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Style="{StaticResource MonthDayCellStyle}">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="{Binding Date,StringFormat=dd}" Style="{StaticResource MonthDayNumberStyle}"/>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tasks}">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Button Tag="{Binding}" Click="Task_Click" MouseDoubleClick="Task_DoubleClick" ContextMenuOpening="Task_ContextMenuOpening"
                   Style="{StaticResource MonthTaskButtonStyle}">
            <Button.ToolTip>
             <ToolTip>
              <StackPanel MaxWidth="360">
               <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
               <TextBlock Text="{Binding TimeDisplay}"/>
               <TextBlock Text="{Binding AssigneeDisplay, StringFormat=Исполнитель: {0}}" TextWrapping="Wrap"/>
               <TextBlock Text="{Binding StatusDisplay, StringFormat=Статус: {0}}"/>
               <TextBlock Text="{Binding CreatorDisplay, StringFormat=Создал: {0}}" TextWrapping="Wrap"/>
               <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
               <TextBlock Text="Двойной щелчок — открыть задачу" Foreground="#5F6368" Margin="0,4,0,0"/>
              </StackPanel>
             </ToolTip>
            </Button.ToolTip>
            <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
            <StackPanel>
             <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
             <TextBlock Text="{Binding TimeDisplay}" FontSize="9" Foreground="White" Opacity="0.92"/>
             <TextBlock FontSize="9" Foreground="White" TextWrapping="Wrap" Opacity="0.92"><Run Text="Исполнитель: "/><Run Text="{Binding AssignedToDisplayName}"/></TextBlock>
             <TextBlock Text="{Binding StatusDisplay, StringFormat=Статус: {0}}" FontSize="9" Foreground="White" Opacity="0.92"/>
            </StackPanel>
           </Button>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
      </DockPanel>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</UserControl>
