<Window x:Class="Planner.App.Views.SettingsWindow" Language="ru-RU"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="../Assets/NetworkPlanner.ico" Title="Настройки — Сетевой планировщик"
 Width="700" Height="640" MinWidth="600" MinHeight="480"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Foreground" Value="#5F6368"/>
  </Style>
  <Style x:Key="PropertyValue" TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,2"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </Window.Resources>

 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>

    <GroupBox Header="Свойства программы">
     <Grid Margin="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Программа" Style="{StaticResource FieldLabel}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Text="Версия" Style="{StaticResource FieldLabel}"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionDisplay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="2" Text="Дата сборки" Style="{StaticResource FieldLabel}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildDateDisplay}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="3" Text="Папка установки" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InstallFolder,Mode=OneWay}" Style="{StaticResource PropertyValue}"/>
      <TextBlock Grid.Row="4" Text="Файл настроек" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SettingsFilePath,Mode=OneWay}" Style="{StaticResource PropertyValue}"/>
      <TextBlock Grid.Row="5" Text="Журнал ошибок" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LogFilePath,Mode=OneWay}" Style="{StaticResource PropertyValue}"/>
     </Grid>
    </GroupBox>

    <GroupBox Header="Сетевая папка с базой" Margin="0,8,0,0">
     <Grid Margin="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Папка с базой" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SharedFolder,UpdateSourceTrigger=PropertyChanged}"/>
      <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Click="BrowseShared_Click" MinWidth="86"/>
      <TextBlock Grid.Row="1" Text="Файл базы" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseFileName,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Grid.Row="2" Text="Папка сигналов" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SignalsFolderName,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="3,4,3,0" TextWrapping="Wrap" Foreground="#5F6368"
                 Text="Все рабочие места должны указывать на одну и ту же папку. После изменения пути программу нужно перезапустить."/>
     </Grid>
    </GroupBox>

    <GroupBox Header="Обновления" Margin="0,8,0,0">
     <Grid Margin="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Папка с обновлениями" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UpdateFolder,UpdateSourceTrigger=PropertyChanged}"/>
      <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Click="BrowseUpdate_Click" MinWidth="86"/>
      <TextBlock Grid.Row="1" Text="Файл описания версии" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UpdateManifestFileName,UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Grid.Row="2" Grid.Column="1" Content="Проверять обновления при запуске" IsChecked="{Binding CheckUpdatesOnStartup}"/>
      <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
       <Button Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}" MinWidth="180"/>
       <Button Content="Установить и перезапустить" Command="{Binding InstallUpdateCommand}" MinWidth="200"
               Background="{StaticResource AccentBrush}" Foreground="White"/>
      </StackPanel>
      <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="3,4,3,0" Foreground="#1A73E8"/>
     </Grid>
    </GroupBox>

    <GroupBox Header="Календарь" Margin="0,8,0,0">
     <Grid Margin="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Шаг сетки, мин" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SnapMinutes}" Width="90" HorizontalAlignment="Left"/>
      <TextBlock Grid.Row="1" Text="Горизонт повторов, мес" Style="{StaticResource FieldLabel}"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecurrenceHorizonMonths}" Width="90" HorizontalAlignment="Left"/>
     </Grid>
    </GroupBox>

   </StackPanel>
  </ScrollViewer>

  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Отмена" IsCancel="True" MinWidth="110"/>
   <Button Content="Сохранить" Click="Save_Click" IsDefault="True" MinWidth="110" Background="{StaticResource AccentBrush}" Foreground="White"/>
  </StackPanel>
 </Grid>
</Window>
