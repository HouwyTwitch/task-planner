<Window x:Class="Planner.App.Views.TaskEditorWindow" Language="ru-RU"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="../Assets/NetworkPlanner.ico" Title="Задача — Сетевой планировщик" Width="620" Height="720" MinWidth="520" MinHeight="440"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="14">
  <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.ColumnSpan="2" Background="#FFF4CE" Padding="8" Margin="3,0,3,8" Visibility="{Binding HasEditModeHint,Converter={StaticResource BoolToVisibility}}">
   <TextBlock Text="{Binding EditModeHint}" TextWrapping="Wrap"/>
  </Border>

  <TextBlock Grid.Row="1" Text="Название" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLimitedEdit}"/>
  <TextBlock Grid.Row="2" Text="Описание / ход работы" VerticalAlignment="Top"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  <TextBlock Grid.Row="3" Text="Исполнитель" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Users}" SelectedItem="{Binding Assignee}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditCore}"/>
  <TextBlock Grid.Row="4" Text="Дата" VerticalAlignment="Center"/><DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Date}" Margin="3" IsEnabled="{Binding CanEditCore}"/>
  <TextBlock Grid.Row="5" Text="Время" VerticalAlignment="Center"/>
  <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanEditCore}">
   <TextBox Text="{Binding Time}" Width="80" IsEnabled="{Binding HasTime}" ToolTip="Формат ЧЧ:ММ, например 09:30"/>
   <TextBlock Text="Длительность" VerticalAlignment="Center" Margin="8,0,3,0"/>
   <TextBox Text="{Binding DurationMinutes}" Width="65" IsEnabled="{Binding HasTime}"/>
   <TextBlock Text="мин" VerticalAlignment="Center"/>
   <CheckBox Content="Без времени" IsChecked="{Binding WithoutTime}" VerticalAlignment="Center" Margin="12,0" IsEnabled="{Binding CanEditCore}"/>
  </StackPanel>
  <TextBlock Grid.Row="6" Text="Статус" VerticalAlignment="Center"/><ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name"/>
  <TextBlock Grid.Row="7" Text="Напоминание" VerticalAlignment="Center"/>
  <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanEditCore}">
   <CheckBox IsChecked="{Binding HasReminder}" Content="Включено" VerticalAlignment="Center"/><TextBox Text="{Binding ReminderValue}" Width="75"/><ComboBox ItemsSource="{Binding ReminderUnits}" SelectedItem="{Binding ReminderUnit}" DisplayMemberPath="Name" Width="125"/>
  </StackPanel>
  <TextBlock Grid.Row="8" Text="Повторение" VerticalAlignment="Center"/><ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding RecurrenceTypes}" SelectedItem="{Binding RecurrenceType}" IsEnabled="{Binding CanEditRecurrence}"/>
  <TextBlock Grid.Row="9" Text="День недели" VerticalAlignment="Center"/><ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Days}" SelectedItem="{Binding WeeklyDay}" DisplayMemberPath="Name" IsEnabled="{Binding IsWeeklyRecurrence}"/>
  <TextBlock Grid.Row="10" Text="Расписание" VerticalAlignment="Center"/>
  <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Cron,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCronRecurrence}">
   <TextBox.ToolTip>
    <StackPanel MaxWidth="420">
     <TextBlock Text="Поддерживаются два формата." FontWeight="SemiBold"/>
     <TextBlock Text="Unix cron, 5 полей: минуты часы день месяц день-недели. Пример: 0 9 * * 1 — по понедельникам в 09:00." TextWrapping="Wrap"/>
     <TextBlock Text="Quartz, 6–7 полей: секунды минуты часы день месяц день-недели [год]. В Quartz воскресенье — 1, суббота — 7, незаданное поле дня записывается знаком «?»." TextWrapping="Wrap" Margin="0,4,0,0"/>
     <TextBlock Text="Пример Quartz: 0 0 9 ? * 2-6 — по будням в 09:00; 0 0 9 L * ? — в последний день месяца." TextWrapping="Wrap"/>
    </StackPanel>
   </TextBox.ToolTip>
  </TextBox>
  <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding RecurrenceHint}" Foreground="#1A73E8" TextWrapping="Wrap" Margin="3,0,3,0"/>
  <CheckBox Grid.Row="12" Grid.Column="1" Margin="3,10,3,0" IsChecked="{Binding ShiftWeekendToWeekday}" IsEnabled="{Binding IsRecurring}"
            Content="Автоперенос с выходных на будний день"
            ToolTip="Повтор, выпавший на субботу или воскресенье, переносится на ближайший будний день перед выходными. Если этот день уже прошёл, задача переносится на ближайший будний день после выходных."/>
  <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Отмена" IsCancel="True" MinWidth="110"/><Button Content="Сохранить" Click="Save_Click" IsDefault="True" Background="#1A73E8" Foreground="White" MinWidth="110"/></StackPanel>
 </Grid></ScrollViewer>
</Window>
